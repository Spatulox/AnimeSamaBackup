{
  "manifest_version": 3,
  "name": "AnimeSamaBackup - Community",
  "description": "Synchronise les données locales entre anime-sama.eu, .si, .fr, etc.",
  "version": "1.1.0",

  "icons": {
    "64": "common/icons/icon64.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "AnimeSamaBackupCommunity@AnimeSamaBackupCommunity",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_end"
    }
  ],

  "permissions": [
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],


  "action": {
    "default_icon": "common/icons/icon64.png",
    "default_title": "AnimeSamaBackup - Community",
    "default_popup": "common/html/popup.html"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "common/html/popup-sync.html",
        "common/css/popup-sync.css",
        "common/css/option.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}